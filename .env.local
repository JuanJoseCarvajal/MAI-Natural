# Variables locales de entorno
NEXT_PUBLIC_SITE_NAME=MAI Natural

# Base de datos PostgreSQL
# Opción 1: PostgreSQL local (localhost:5432)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mai_natural?schema=public"

# Opción 2: Supabase (descomentar y usar tu URL)
# DATABASE_URL="postgresql://[user]:[password]@db.[project].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="$(openssl rand -base64 32)"
NEXTAUTH_URL="http://localhost:3000"

# Calendly
NEXT_PUBLIC_CALENDLY_URL=
CALENDLY_WEBHOOK_SECRET=mai-natural-webhook-secret-2026
